APP_NAME=ForecastX
APP_ENV=development
DEMO_MODE=true

# Database & Cache
DATABASE_URL=sqlite:///./forecastx.db
# For production PostgreSQL + PostGIS:
# DATABASE_URL=postgresql://forecastx_user:forecastx_pass@localhost:5432/forecastx_db
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=forecastx-authoritative-met-key-2026-safe-india

# AI Engine Provider (fallback, gemini, openai, local)
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434/v1

# Authoritative Meteorological Services
IMD_API_KEY=
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
ECMWF_API_KEY=
ECMWF_URL=https://api.ecmwf.int/v1
MOSDAC_CONFIG=

# GIS & Maps
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
GEOCODING_PROVIDER=internal

# Speech & Voice Interfaces
TTS_PROVIDER=browser
STT_PROVIDER=browser
